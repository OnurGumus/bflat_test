<!-- Packs the MSBuild SDK (Sdk/) and its payload (payload/, made by build-payload.sh). No code. -->
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../version.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>

    <PackageId>ZeroCSharp.Sdk</PackageId>
    <Version>$(ZeroSdkVersion)</Version>
    <PackageType>MSBuildSdk</PackageType>
    <Authors>Zero C# contributors</Authors>
    <Description>Zero-mode C#: C# compiled to small native programs with no .NET runtime. Use as &lt;Project Sdk="ZeroCSharp.Sdk/$(ZeroSdkVersion)"&gt;.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://onurgumus.github.io/zero-csharp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OnurGumus/zero-csharp</RepositoryUrl>
    <PackageTags>csharp;native;nativeaot;bflat;zero</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
    <None Include="../version.props" Pack="true" PackagePath="Sdk/" />
    <None Include="payload/**" Pack="true" PackagePath="payload/" />
  </ItemGroup>
</Project>
