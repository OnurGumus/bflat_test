<!-- What an existing .NET repository's Directory.Build.props often sets; a
     zero project added to that repository inherits it. -->
<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
